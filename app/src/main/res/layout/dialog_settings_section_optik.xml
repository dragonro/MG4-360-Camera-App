<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionOptik"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        style="@style/DrivehubSettingsSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/settings_section_tileview" />

    <TextView
        style="@style/DrivehubSettingsPrimaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/settings_tile_corner_radius" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SeekBar
            style="@style/DrivehubSettingsSlider"
            android:id="@+id/seekCornerRadius"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:max="35"
            android:progress="16" />

        <EditText
            style="@style/DrivehubSettingsSliderValue"
            android:id="@+id/etCornerRadius"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/settings_text_muted"
            android:textSize="14sp"
            android:text="@string/settings_tile_corner_square" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/settings_text_muted"
            android:textSize="14sp"
            android:text="@string/settings_tile_corner_round" />

    </LinearLayout>

</LinearLayout>
