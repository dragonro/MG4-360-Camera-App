<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBackSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Geri"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swRecordEnabled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Kayıt açık (Bootta otomatik başlasın)"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBackSettings" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swOverlayOnSignal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sinyalde kamera overlay aç"
            app:layout_constraintTop_toBottomOf="@id/swRecordEnabled"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swKillOemOnReverse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="OEM 360 kamera uygulamasını devre dışı bırak"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/swOverlayOnSignal" />

        <TextView
            android:id="@+id/tvOverlayHideDelay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Overlay kapanma gecikmesi (sn)"
            app:layout_constraintTop_toBottomOf="@id/swKillOemOnReverse"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etOverlayHideDelaySeconds"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ems="6"
            android:hint="1.5"
            android:inputType="numberDecimal"
            app:layout_constraintTop_toBottomOf="@id/swKillOemOnReverse"
            app:layout_constraintStart_toEndOf="@id/tvOverlayHideDelay"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSegment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kayıt döngüsü (dk)"
            app:layout_constraintTop_toBottomOf="@id/tvOverlayHideDelay"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etSegmentMin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:ems="6"
            android:hint="3"
            app:layout_constraintTop_toBottomOf="@id/swRecordEnabled"
            app:layout_constraintStart_toEndOf="@id/tvSegment"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Toplam saklama (dk)"
            app:layout_constraintTop_toBottomOf="@id/tvSegment"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etTotalMin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:ems="6"
            android:hint="30"
            app:layout_constraintTop_toBottomOf="@id/tvSegment"
            app:layout_constraintStart_toEndOf="@id/tvTotal"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvRecordsPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Kayıt yolu"
            app:layout_constraintTop_toBottomOf="@id/etTotalMin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnExportUsb"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Kayıtları USB’ye aktar (TODO)"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvRecordsPath"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

