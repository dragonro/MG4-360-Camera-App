<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_card"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="24dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tvOtaProgressSection"
        style="@style/DrivehubSettingsSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/ota_dialog_title" />

    <TextView
        android:id="@+id/tvOtaProgressTitle"
        style="@style/DrivehubSettingsPrimaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/ota_dialog_title" />

    <ProgressBar
        android:id="@+id/pbOtaDownload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:indeterminate="true"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/settings_update_available_text" />

    <TextView
        android:id="@+id/tvOtaProgressStatus"
        style="@style/DrivehubSettingsCreditsBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="22dp"
        android:text="@string/ota_progress_preparing" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnOtaClose"
            style="@style/DrivehubDialogButtonSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ota_action_close" />

        <TextView
            android:id="@+id/btnOtaOpenDownloads"
            style="@style/DrivehubDialogButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/ota_action_open_downloads" />

        <TextView
            android:id="@+id/btnOtaRetryDownload"
            style="@style/DrivehubDialogButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/ota_action_retry_download"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnOtaInstallUpdate"
            style="@style/DrivehubDialogButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/ota_action_install_update"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
