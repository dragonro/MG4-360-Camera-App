<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionSettings"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/DrivehubSettingsHeading2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="@string/settings_section_display" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/DrivehubSettingsLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/show_safety_warning" />

        <Switch
            style="@style/DrivehubSettingsSwitch"
            android:id="@+id/switchSafetyWarning"
            />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/DrivehubSettingsLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_enable_camera_popup" />

        <Switch
            style="@style/DrivehubSettingsSwitch"
            android:id="@+id/switchEnableCameraPopup" />

    </LinearLayout>

    <TextView
        style="@style/DrivehubSettingsHeading2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="2dp"
        android:text="@string/settings_section_recording" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/DrivehubSettingsLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_enable_recording" />

        <Switch
            style="@style/DrivehubSettingsSwitch"
            android:id="@+id/switchEnableRecording"
            />

    </LinearLayout>

    <TextView
        style="@style/DrivehubSettingsHeading2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="2dp"
        android:text="@string/settings_records_path" />

    <TextView
        android:id="@+id/tvRecordsPathValue"
        style="@style/DrivehubSettingsBodyMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/settings_records_path_default" />

    <Button
        android:id="@+id/btnExportUsb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/settings_export_usb" />

    <TextView
        style="@style/DrivehubSettingsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_recording_duration" />

    <RadioGroup
        android:id="@+id/rgRecordingDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbRecordingDuration1"
            style="@style/DrivehubSettingsRadioButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1 min" />

        <RadioButton
            android:id="@+id/rbRecordingDuration2"
            style="@style/DrivehubSettingsRadioButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2 min" />

        <RadioButton
            android:id="@+id/rbRecordingDuration5"
            style="@style/DrivehubSettingsRadioButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5 min" />

        <RadioButton
            android:id="@+id/rbRecordingDuration10"
            style="@style/DrivehubSettingsRadioButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="10 min" />

    </RadioGroup>
</LinearLayout>
