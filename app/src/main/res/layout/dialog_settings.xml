<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="560dp"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_close"
            android:tint="@color/settings_text_primary"
            android:background="@android:color/transparent"
            android:padding="14dp"
            android:contentDescription="Close"
            android:focusable="false" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <TextView
            android:id="@+id/tabSettings"
            style="@style/DrivehubSettingsTabActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Settings" />

        <TextView
            android:id="@+id/tabCredits"
            style="@style/DrivehubSettingsTabInactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Credits" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="8dp"
        android:background="@color/settings_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Android resource folders do not support free nested subfolders here,
                 so the dialog is split into separate include files with a clear prefix instead. -->
            <include layout="@layout/dialog_settings_section_settings" />

            <include layout="@layout/dialog_settings_section_credits" />

        </FrameLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvDialogVersion"
        style="@style/DrivehubSettingsFooterVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:text="Version: -" />

    <TextView
        android:id="@+id/tvDialogFooterAuthor"
        style="@style/DrivehubSettingsFooterAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="by jamakr4 &amp; merth4n" />

</LinearLayout>
