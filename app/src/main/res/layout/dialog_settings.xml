<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="560dp"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF"
            android:background="@android:color/transparent"
            android:padding="14dp"
            android:contentDescription="Close"
            android:focusable="false" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <TextView
            android:id="@+id/tabSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="28dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabCredits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="Credits"
            android:textColor="#777777"
            android:textSize="20sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="8dp"
        android:background="#2D2D2D" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/sectionSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:text="DRIVING"
                    android:textColor="#888888"
                    android:textSize="16sp"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Show tile view on turn signal"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />

                    <Switch
                        android:id="@+id/switchOverlayOnSignal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:showText="false"
                        android:splitTrack="false"
                        android:scaleX="1.1"
                        android:scaleY="1.1"
                        android:track="@drawable/switch_selector_green"
                        android:thumb="@drawable/switch_white_circle_selector" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="#2D2D2D" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:text="DISPLAY"
                    android:textColor="#888888"
                    android:textSize="16sp"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/show_safety_warning"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />

                    <Switch
                        android:id="@+id/switchSafetyWarning"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:showText="false"
                        android:splitTrack="false"
                        android:scaleX="1.1"
                        android:scaleY="1.1"
                        android:track="@drawable/switch_selector_green"
                        android:thumb="@drawable/switch_white_circle_selector" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sectionCredits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="5dp"
                    android:text="Analysis based on community research from XDA Forums - MG4 Electric AAOS 9&#10;&#10;Tile View based on merth4n&#10;&#10;Uses OpenCV 4.9.0 (opencv.org) - Apache License 2.0&#10;&#10;Icons based on Google Material Symbols - Apache License 2.0"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tvDialogVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:textSize="18sp"
        android:textColor="#555555"
        android:text="Version: -" />

    <TextView
        android:id="@+id/tvDialogFooterAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:textSize="14sp"
        android:textColor="#555555"
        android:text="by jamakr4" />

</LinearLayout>
