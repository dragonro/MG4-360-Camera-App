<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF"
            android:background="@android:color/transparent"
            android:padding="14dp"
            android:contentDescription="Close"
            android:focusable="false" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TURN SIGNAL CAMERA"
            android:textColor="#888888"
            android:textSize="16sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Show camera overlay on turn signal"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Switch
                android:id="@+id/switchOverlayOnSignal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:showText="false"
                android:splitTrack="false"
                android:scaleX="1.1"
                android:scaleY="1.1"
                android:track="@drawable/switch_selector_green"
                android:thumb="@drawable/switch_white_circle_selector" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:background="#2D2D2D" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DISPLAY"
            android:textColor="#888888"
            android:textSize="16sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/show_safety_warning"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <Switch
                android:id="@+id/switchSafetyWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:showText="false"
                android:splitTrack="false"
                android:scaleX="1.1"
                android:scaleY="1.1"
                android:track="@drawable/switch_selector_green"
                android:thumb="@drawable/switch_white_circle_selector" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvDialogVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:textSize="18sp"
        android:textColor="#555555"
        android:text="Version: -" />

    <TextView
        android:id="@+id/tvDialogFooterAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:textSize="14sp"
        android:textColor="#555555"
        android:text="made by  jamakr4" />

</LinearLayout>
