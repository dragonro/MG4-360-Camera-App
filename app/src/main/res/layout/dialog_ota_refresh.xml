<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_card"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="24dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tvOtaRefreshTitle"
        style="@style/DrivehubSettingsHeading2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/ota_dialog_title" />

    <TextView
        android:id="@+id/tvOtaRefreshMessage"
        style="@style/DrivehubSettingsBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        android:text="@string/ota_dialog_check_failed_message" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnOtaClose"
            style="@style/DrivehubDialogButtonSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ota_action_close" />

        <TextView
            android:id="@+id/btnOtaRefresh"
            style="@style/DrivehubDialogButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/ota_action_refresh" />
    </LinearLayout>

</LinearLayout>
