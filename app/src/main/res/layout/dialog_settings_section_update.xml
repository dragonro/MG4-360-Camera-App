<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sectionUpdate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/DrivehubSettingsSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:text="@string/settings_section_update_channel" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/DrivehubSettingsPrimaryText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_allow_beta_updates" />

        <Switch
            android:id="@+id/switchAllowBetaUpdates"
            style="@style/DrivehubSettingsSwitch" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvUpdateChannelStatus"
        style="@style/DrivehubSettingsDetailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:text="@string/ota_update_channel_loading" />

    <TextView
        style="@style/DrivehubSettingsSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:text="@string/settings_section_update_status" />

    <TextView
        android:id="@+id/tvUpdateSourceGithub"
        style="@style/DrivehubSettingsDetailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ota_source_status_loading" />

    <TextView
        android:id="@+id/tvUpdateSourceGitlab"
        style="@style/DrivehubSettingsDetailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/ota_source_status_loading" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/settings_divider" />

    <TextView
        style="@style/DrivehubSettingsSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/settings_section_latest_release" />

    <TextView
        android:id="@+id/tvUpdateReleaseTitle"
        style="@style/DrivehubSettingsPrimaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ota_update_section_loading" />

    <TextView
        style="@style/DrivehubSettingsDetailText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/ota_update_hint" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp"
        android:background="@color/settings_divider" />

    <TextView
        style="@style/DrivehubSettingsSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/settings_section_changelog" />

    <TextView
        android:id="@+id/tvUpdateChangelog"
        style="@style/DrivehubSettingsChangelogBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ota_update_changelog_loading"
        android:textIsSelectable="false" />

</LinearLayout>
