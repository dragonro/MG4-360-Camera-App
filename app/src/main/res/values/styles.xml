<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Active tab label in the settings dialog header. -->
    <style name="DrivehubSettingsTabActive" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/settings_accent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Inactive tab label in the settings dialog header. -->
    <style name="DrivehubSettingsTabInactive" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/settings_tab_inactive</item>
    </style>

    <!-- Small uppercase subsection title like DRIVING, DISPLAY or CREDITS headers. -->
    <style name="DrivehubSettingsSectionHeader" parent="">
        <item name="android:textColor">@color/settings_text_highlight</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Main row label text for settings options. -->
    <style name="DrivehubSettingsPrimaryText" parent="">
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Shared switch treatment for settings screens. Keep size and assets centralized. -->
    <style name="DrivehubSettingsSwitch" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:focusable">false</item>
        <item name="android:scaleX">0.9</item>
        <item name="android:scaleY">0.9</item>
        <item name="android:showText">false</item>
        <item name="android:splitTrack">false</item>
        <item name="android:switchMinWidth">54dp</item>
        <item name="android:switchPadding">0dp</item>
        <item name="android:thumbTextPadding">0dp</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:thumb">@drawable/switch_white_circle_selector</item>
        <item name="android:track">@drawable/switch_selector_green</item>
    </style>

    <!-- Shared visual sizing for settings sliders. -->
    <style name="DrivehubSettingsSlider" parent="">
        <item name="android:layout_height">32dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:progressDrawable">@drawable/settings_slider_track</item>
        <item name="android:thumb">@drawable/settings_slider_thumb</item>
        <item name="android:thumbOffset">0dp</item>
        <item name="android:splitTrack">false</item>
        <item name="android:focusable">false</item>
    </style>

    <!-- Shared compact numeric value next to sliders in settings. -->
    <style name="DrivehubSettingsSliderValue" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">2</item>
        <item name="android:textColor">@color/settings_text_secondary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Body text used for credit lists and acknowledgements. -->
    <style name="DrivehubSettingsCreditsBody" parent="">
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <style name="DrivehubSettingsChangelogBody" parent="">
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>

    <style name="DrivehubSettingsDetailText" parent="">
        <item name="android:textColor">@color/settings_text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>

    <!-- Version label shown at the bottom of the dialog. -->
    <style name="DrivehubSettingsFooterVersion" parent="">
        <item name="android:textColor">@color/settings_text_muted</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Red beta badge shown next to the version when beta builds are enabled. -->
    <style name="DrivehubSettingsFooterBeta" parent="">
        <item name="android:textColor">@color/settings_beta</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small author / attribution line below the version. -->
    <style name="DrivehubSettingsFooterAuthor" parent="">
        <item name="android:textColor">@color/settings_text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Clickable OTA status badge at the bottom of the settings dialog. -->
    <style name="DrivehubSettingsFooterTag" parent="">
        <item name="android:textColor">@color/settings_update_error_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:background">@drawable/bg_settings_footer_tag_neutral</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="DrivehubDialogButtonPrimary" parent="">
        <item name="android:background">@drawable/bg_dialog_button_primary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">118dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DrivehubDialogButtonSecondary" parent="">
        <item name="android:background">@drawable/bg_dialog_button_secondary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">118dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/settings_text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
