<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:remove="android:sharedUserId">

    <application>
        <activity
            android:name=".TileViewActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <receiver
            android:name=".DebugSignalSimulationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.drivehub.kamera.debug.SET_SIGNAL_STATE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".SignalService"
            android:exported="true"
            tools:replace="android:exported" />
    </application>

</manifest>
